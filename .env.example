# PostHog project API key (US cloud). Unset = no analytics loaded.
NEXT_PUBLIC_POSTHOG_KEY=
# HubSpot tracking code. SETS COOKIES: enable HubSpot's cookie consent banner first (see README).
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# Optional. Default js.hs-scripts.com (US portals). EU portals: js-eu1.hs-scripts.com
NEXT_PUBLIC_HUBSPOT_SCRIPT_HOST=
